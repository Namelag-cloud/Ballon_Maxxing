# Local ML training outputs and image datasets
training/artifacts/*
!training/artifacts/.gitkeep
training/dataset/train/*/*
training/dataset/val/*/*
training/dataset/test/*/*
!training/dataset/train/*/.gitkeep
!training/dataset/val/*/.gitkeep
!training/dataset/test/*/.gitkeep

training/raw/*
!training/raw/.gitkeep

# Python bytecode / caches
__pycache__/
*.py[cod]
*.class

# Generated telemetry output
telemetry_output/*
!telemetry_output/.gitkeep
